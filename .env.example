# HuntPilot AI Environment Configuration Example
# Copy this file to .env and configure your production/cloud secret keys.
# Note: OAuth token encryption at rest in Firestore is handled automatically via zero-config server-side managed keys. No OAUTH_STORAGE_SECRET is required.

# Product Hunt GraphQL API Credentials (Server-to-Server Client Credentials)
PRODUCT_HUNT_API_KEY=
PRODUCT_HUNT_API_SECRET=

# Optional Product Hunt MCP URL override
PRODUCT_HUNT_MCP_URL=https://mcp.producthunt.com/mcp

# Optional OAuth Client credentials for interactive MCP user login
PRODUCT_HUNT_OAUTH_CLIENT_ID=
PRODUCT_HUNT_OAUTH_CLIENT_SECRET=